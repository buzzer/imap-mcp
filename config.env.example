# Copy to config.env and protect it with chmod 600.

# Hetzner: the default is mail.your-server.de. Some packages use their own
# server (e.g. wwwXXX.your-server.de) - shown in konsoleH next to the mailbox credentials.
IMAP_HOST=mail.your-server.de
IMAP_PORT=993

# Optional: name of the first account (default "hetzner"); only used without ACCOUNTS.
# ACCOUNT_NAME=hetzner
# Optional: socket timeout in seconds for IMAP operations (default 30).
# IMAP_TIMEOUT=30

MAIL_USER=user@example.com
MAIL_PASSWORD=change-me
MAIL_FROM_NAME=Your Name

# Additional sender addresses (aliases), comma-separated. "*@example.com" allows any
# address of the domain. Only use addresses that Hetzner accepts as sender for this
# mailbox, otherwise mails end up in spam later or get rejected.
MAIL_ALIASES=shop@example.com,dev@example.com

# Optional: otherwise detected automatically (\Drafts flag or "Drafts"/"Entwürfe")
# DRAFTS_FOLDER=Drafts

# Optional, global for all accounts: read_message sets the \Seen flag on every message
# it returns, so a mail client shows what the assistant has looked at (default: off).
# MARK_READ_ON_READ=true

# Optional, global for all accounts: every draft gets the sender address as Bcc, so you
# keep a copy of what was sent from a draft (default: off).
# BCC_SELF=true

# Optional: allow create_draft to attach files (.pdf, .png, .jpg, .jpeg only) from this
# folder. Without it, attaching is disabled. Use a dedicated folder, no symlinks/dotfiles.
# ATTACHMENT_DIR=/opt/imap-mcp/attachments
# Limits (no comment after the value: config.env has no inline comments).
# Per file in bytes, default 10 MB:
# ATTACHMENT_MAX_BYTES=10485760
# Per draft in bytes, default 15 MB:
# ATTACHMENT_MAX_TOTAL_BYTES=15728640
# Number of attachments per draft, default 5:
# ATTACHMENT_MAX_COUNT=5

# Only for --transport http (min. 32 characters):
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# MCP_AUTH_TOKEN=

# TLS for --transport http (create the certificate with scripts/make-cert.sh):
# TLS_CERT=/path/to/imap-mcp/certs/server.crt
# TLS_KEY=/path/to/imap-mcp/certs/server.key

# ---------------------------------------------------------------------------
# Additional accounts (optional). The first account in ACCOUNTS is the default and
# may use the unprefixed keys above; all others use the prefix NAME_.
# ---------------------------------------------------------------------------
# ACCOUNTS=hetzner,icloud

# iCloud: server imap.mail.me.com:993 (default for the account name "icloud").
# The login is usually the part before @icloud.com, otherwise try the full address.
# Password: app-specific password from account.apple.com
# (Sign-In and Security > App-Specific Passwords), NOT the Apple ID password.
# ICLOUD_MAIL_USER=first.last
# ICLOUD_MAIL_ADDRESS=first.last@icloud.com
# ICLOUD_MAIL_PASSWORD=abcd-efgh-ijkl-mnop
# ICLOUD_MAIL_ALIASES=first.last@me.com,first.last@mac.com
